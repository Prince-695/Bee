# API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEBUG=false

# Database
DB_PATH=./bee.db

# Log Storage
LOG_FILE_PATH=./bee.logs.jsonl
LOG_TERMINAL_ENABLED=true
LOG_TERMINAL_FORMAT=json
LOG_TERMINAL_MIN_LEVEL=INFO

# LLM Planner
LLM_API_KEY=
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=16384
LLM_ENABLE_THINKING=true
LLM_REASONING_BUDGET=16384
LLM_STREAM_TERMINAL_ENABLED=false

# Encryption
TOKEN_ENCRYPTION_KEY=

# Hive / MCP credentials
GITHUB_PERSONAL_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
NOTION_API_TOKEN=
POSTGRES_CONNECTION_STRING=
LINEAR_API_KEY=
FILESYSTEM_PATH=

ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# Optional: python used to spawn local Hive runners
BEE_PYTHON_BIN=
