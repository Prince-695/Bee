# ==============================================================================
# 🐝 BEE MONOREPO MASTER CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env or apps/api/.env to configure the platform.
# NOTE: Never commit live .env to version control.
# ==============================================================================

# ─── 1. SERVER & SECURITY ───────────────────────────────────────────────────
PORT=8000
BEE_API_PORT=8000
ENVIRONMENT=production
API_URL_SCHEME=http
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://bee.dev
DEBUG=false

# Swagger / OpenAPI Documentation Protection
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin123

# JWT Secret Key for /v1/auth/* access & refresh token signing
JWT_SECRET=bee_jwt_super_secret_signing_key_change_in_production_32chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM Vault Key for encrypting tenant third-party tokens at rest
TOKEN_ENCRYPTION_KEY=bee_secure_aes_encryption_key_change_me_in_prod_32char

# ─── 2. DATABASE (POSTGRESQL + PGVECTOR OR SQLITE) ──────────────────────────
# Cloud SaaS: PostgreSQL connection string
DATABASE_URL=postgresql://bee:beepassword@localhost:5432/bee_db
# Local Desktop Offline Fallback
DB_PATH=./bee.db

# ─── 3. CENTRAL LLM AI GATEWAY ──────────────────────────────────────────────
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ─── 4. EMAIL & OTP (SMTP) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bee Security <security@bee.dev>

# ─── 5. OAUTH & THIRD-PARTY PLATFORM CREDENTIALS ────────────────────────────
# Note: Platform credentials (Slack, Jira, GitHub) can also be added via the UI
# at /v1/credentials and stored encrypted in the tenant vault.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gmail MCP Worker Credentials (Optional: if connecting Hive Gmail worker)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token

# ─── 6. MULTI-CHANNEL & EMERGENCY ALERT NOTIFICATIONS ───────────────────────
WHATSAPP_VERIFY_TOKEN=bee_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Twilio Automated Voice Escalation for Sev-1 Critical Gates
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
