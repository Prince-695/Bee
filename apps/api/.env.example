# ==============================================================================
# 🐝 BEE API & BACKEND SERVICE — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# NOTE FOR DEVELOPERS & OPERATORS:
# Bee is dual-mode:
# 1. Local/Desktop mode: Requires zero setup (defaults to SQLite ./bee.db).
# 2. Cloud/Production SaaS mode: Set DATABASE_URL to your Neon Postgres connection.
# ==============================================================================

# ─── 1. SERVER & SECURITY ───────────────────────────────────────────────────
PORT=8000
BEE_API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://bee.dev
DEBUG=false

# JWT Secret Key for /v1/auth/* access & refresh token signing (min 32 chars in prod)
JWT_SECRET=bee_jwt_super_secret_signing_key_change_in_production_32chars

# AES-256 Key for encrypting user tokens and secrets at rest
TOKEN_ENCRYPTION_KEY=bee_secure_aes_encryption_key_change_me_in_prod_32char

# ─── 2. DATABASE & PERSISTENCE (NEON POSTGRES OR LOCAL SQLITE) ─────────────
# Cloud SaaS: Neon Serverless Postgres with pgvector
# Format: postgresql://user:password@ep-cool-project.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Local Desktop / Offline Fallback (used when DATABASE_URL is empty)
DB_PATH=./bee.db

# ─── 3. CENTRAL LLM AI GATEWAY (REQUIRED) ───────────────────────────────────
# Google Gemini (Default recommended), OpenAI, Anthropic, DeepSeek, or Groq
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ─── 4. EMAIL & 6-DIGIT OTP VERIFICATION (SMTP) ─────────────────────────────
# If left empty, Bee uses an automated mock logger in development mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bee Security <security@bee.dev>

# ─── 5. 1-CLICK OAUTH CREDENTIALS (GOOGLE & GITHUB) ─────────────────────────
# Register your OAuth App on Google Cloud Console and GitHub Developer Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── 6. WEBHOOKS & EVENT INGESTION ──────────────────────────────────────────
# Secret for verifying inbound GitHub Pull Request & Push events (/webhooks/github)
GITHUB_WEBHOOK_SECRET=

# ─── 7. MULTI-CHANNEL HUMAN APPROVALS (WHATSAPP & SLACK) ───────────────────
# Meta / WhatsApp Cloud API credentials for mobile 1-click [Authorize] alerts
WHATSAPP_VERIFY_TOKEN=bee_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Slack Bot credentials for interactive Block Kit approval cards
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─── 8. STRUCTURED LOGGING & TELEMETRY ─────────────────────────────────────
LOG_FILE_PATH=./bee.logs.jsonl
LOG_TERMINAL_ENABLED=true
LOG_TERMINAL_FORMAT=json
LOG_TERMINAL_MIN_LEVEL=INFO
