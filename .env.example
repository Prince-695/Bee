# ==============================================================================
# BEE AUTONOMOUS AI CO-ENGINEER — PRODUCTION & SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE FOR END USERS / NON-CODERS:
# You DO NOT need to configure SaaS API keys (GitHub, Google, Slack, Discord) here!
# End users connect their tools directly in the UI via 1-Click OAuth buttons.
# This file is only for server administrators deploying the Bee Backend.
# ==============================================================================

# ─── 1. SERVER & SECURITY (REQUIRED) ─────────────────────────────────────────
PORT=8000
BEE_API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bee.dev
DEBUG=false

# SQLite / Database path
DB_PATH=./bee.db

# AES-256 Key for encrypting stored user OAuth tokens in SQLite
TOKEN_ENCRYPTION_KEY=bee_secure_aes_encryption_key_change_me_in_prod_32char

# Log Storage & Telemetry
LOG_FILE_PATH=./bee.logs.jsonl
LOG_TERMINAL_ENABLED=true
LOG_TERMINAL_FORMAT=json
LOG_TERMINAL_MIN_LEVEL=INFO

# ─── 2. CENTRAL LLM AI GATEWAY (REQUIRED) ─────────────────────────────────────
# Configure your central AI provider (OpenAI, Google Gemini, NVIDIA, DeepSeek, Anthropic)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ─── 3. 1-CLICK OAUTH APPLICATION CREDENTIALS (SERVER LEVEL) ──────────────────
# Server admin registers OAuth apps once on GitHub/Google/Slack so all users can 1-click connect.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── 4. WEBHOOKS & EVENT INGESTION (OPTIONAL) ─────────────────────────────────
# HMAC secret for verifying incoming GitHub Pull Request & Push webhooks (/webhooks/github)
GITHUB_WEBHOOK_SECRET=

# ─── 5. MULTI-CHANNEL HUMAN INTERACTION GATEWAY (WHATSAPP & SLACK) ────────────
# Meta / WhatsApp Cloud API webhook handshake token & credentials for mobile 1-click approvals
WHATSAPP_VERIFY_TOKEN=bee_whatsapp_secret_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Slack Bot credentials for interactive Block Kit approval buttons
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
