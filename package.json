{
  "name": "bee",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prince-695/bee.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "PYTHONPATH=apps/api:services:packages/python/bee-core:packages/python/bee-hive:packages/python/bee-logging ./.venv/bin/python -m uvicorn bee_api.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:desktop:web": "turbo run dev --filter=@bee/desktop",
    "dev:web": "turbo run dev --filter=@bee/web",
    "dev:desktop": "pnpm --filter @bee/desktop dev:desktop",
    "build": "turbo run build",
    "build:console": "turbo run build --filter=@bee/desktop",
    "build:web": "turbo run build --filter=@bee/web",
    "build:desktop": "pnpm --filter @bee/desktop build:desktop",
    "package:win": "pnpm --filter @bee/desktop package:win",
    "package:linux": "pnpm --filter @bee/desktop package:linux",
    "package:mac": "pnpm --filter @bee/desktop package:mac",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "node tools/scripts/generate-api-client.mjs",
    "codegen:check": "node tools/scripts/generate-api-client.mjs --check"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "shadcn": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3"
  }
}
