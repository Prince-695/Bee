FROM python:3.11-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY packages/python ./packages/python
COPY apps/api ./apps/api
COPY tools/hive-local ./tools/hive-local

RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip \
 && /opt/venv/bin/pip install -e packages/python/bee-logging \
 && /opt/venv/bin/pip install -e packages/python/bee-hive \
 && /opt/venv/bin/pip install -e packages/python/bee-core \
 && /opt/venv/bin/pip install -e apps/api

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

WORKDIR /app/apps/api
EXPOSE 8000
CMD ["uvicorn", "bee_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
